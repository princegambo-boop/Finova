# ==============================================================================
# FINOVA Application Environment Variables Example
# Copy this file to .env or .env.local and fill in your actual credentials.
# NOTE: Never commit .env or .env.local to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Configuration
# Obtain these values from your Firebase Console -> Project Settings -> Your apps
# ------------------------------------------------------------------------------
FIREBASE_API_KEY="your-api-key"
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
FIREBASE_APP_ID="your-firebase-app-id"
FIREBASE_MEASUREMENT_ID="your-measurement-id"
FIREBASE_DATABASE_ID="your-database-id"

# ------------------------------------------------------------------------------
# Gemini AI Configuration
# Required for Gemini AI features. AI Studio automatically injects this at runtime.
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# Application URL
# The hosting URL where the application is served.
# ------------------------------------------------------------------------------
APP_URL="https://your-domain.com"
